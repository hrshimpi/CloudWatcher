APP_NAME=CloudWatcher
ENVIRONMENT=development

POSTGRES_USER=cloudwatcher
POSTGRES_PASSWORD=cloudwatcher
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=cloudwatcher

# Optional: used to ask an LLM for a one-sentence root-cause guess on Slack
# alerts. Leave unset to always use the templated (numbers-only) explanation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=10
SLACK_TIMEOUT_SECONDS=5

# Logs alerts instead of posting to Slack. Set to false once a real webhook
# is configured in the alert_config table.
ALERTS_DRY_RUN=true

# Optional deploy-time default webhook, used only until someone configures a
# global alert_config row via the Settings UI (which then takes precedence).
SLACK_WEBHOOK_URL=

# Set by Cloud Run to connect to Cloud SQL via the Auth Proxy's Unix socket
# instead of TCP; leave unset for local dev.
POSTGRES_SOCKET_DIR=
