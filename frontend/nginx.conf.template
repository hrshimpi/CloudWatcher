server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Same relative-path contract as the Vite dev proxy: the browser only
    # ever talks to this origin, and /api/* gets forwarded server-side to
    # the backend Cloud Run service. The target URL below is templated in
    # by docker-entrypoint.sh at container start (see API_BASE_URL). This
    # also means the backend never needs CORS configured.
    location /api/ {
        proxy_pass $API_BASE_URL/;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # Client-side routing (React Router): let unknown paths fall through to
    # index.html instead of a raw nginx 404.
    location / {
        try_files $uri /index.html;
    }
}
